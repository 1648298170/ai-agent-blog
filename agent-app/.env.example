# ===== LLM 网关配置（OpenAI 兼容协议，默认智谱 GLM，也可三选一） =====
#
# OPENAI_BASE_URL 可选值：
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4   ← 默认
#   DeepSeek       https://api.deepseek.com/v1
#   通义千问 Qwen   https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 对应 OPENAI_MODEL 参考值：
#   GLM:       glm-4-flash / glm-4-air / glm-4-plus
#   DeepSeek:  deepseek-chat
#   Qwen:      qwen-plus / qwen-turbo / qwen-max

OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash

# ===== Embedding 模型 =====
# 注意：查询与入库必须用同一个模型，混用则坐标空间不同，检索直接失真。
# 默认 GLM 网关自带 embeddings 接口；换网关时 EMBEDDING_MODEL 要跟着换：
#   GLM  示例: embedding-3（默认）/ embedding-2
#   Qwen 示例: text-embedding-v3（OPENAI_BASE_URL 用上面的 dashscope compatible-mode）
#   OpenAI : text-embedding-3-small（原生 1536 维）
#   注意：DeepSeek 网关不提供 embeddings 接口，切到 DeepSeek 后 RAG 不可用
EMBEDDING_MODEL=embedding-3

# ===== HTTP API（NestJS BFF，pnpm api 启动） =====
# 监听端口；不配置时默认 3000。环境变量 PORT 优先于 .env 文件里的值。
# PORT=3000

# ===== 工具审批（week18 Day 6，human-in-the-loop） =====
# 高危工具名单：流式对话里命中名单的工具执行前，BFF 先发 approval SSE 事件，
# 等用户在 web 界面点「允许 / 拒绝」（POST /api/chat/approve）再放行；拒绝时工具
# 收到结构化拒绝值 { denied: true, reason }，模型看得见、能礼貌收尾。
# 逗号分隔；未配置时默认 createTicket；显式置空（AGENT_CONFIRM_TOOLS=）= 关闭审批。
# AGENT_CONFIRM_TOOLS=createTicket
#
# 审批等待上限（毫秒）：超时未裁决自动拒绝并清理审批条目（默认 60000 = 60s）。
# AGENT_CONFIRM_TIMEOUT_MS=60000

# ===== LLM 调用策略（AI SDK 内置能力，BACKLOG #3 落地） =====
# 传输层重试：429/5xx/网络错误自动指数退避重试（默认 2 次；0 = 关闭重试）
# AGENT_LLM_MAX_RETRIES=2
#
# 单次模型调用超时（毫秒，默认 60000 = 60s）：经 AbortSignal.timeout 实施，
# 与调用方自己的 signal（如 SSE 断连中止）合并——任一触发即中止。
# AGENT_LLM_TIMEOUT_MS=60000

# ===== token 估算器（memory 压缩/水位线的度量地基） =====
# tiktoken = js-tiktoken cl100k_base 编码近似（默认）；chars = 字符系数兜底（中文1/字 英文0.25/字符）
# AGENT_TOKEN_ESTIMATOR=tiktoken

# ===== 压缩水位线（BACKLOG ①：条数阈值 → token 水位） =====
# 模型上下文窗口 token 数。配置后压缩按 token 水位触发（窗口×75% 触发，压到×50%）。
# 不配此键时按 OPENAI_MODEL 自动查表——已收录 glm-4-flash/4-air/4-plus/4.5/4.5-air(128K)、
# glm-4.6(200K)、deepseek-chat/reasoner(64K)、moonshot-v1-8k/32k/128k、qwen-plus(131072)；
# 换表外模型会打告警且水位线不启用（走回 40 条阈值），此时手动配此键兜底；
# 显式关闭：MODEL_CONTEXT_TOKENS=off
# MODEL_CONTEXT_TOKENS=128000

# ===== 日志形态（默认 text = 教学 icon/console 直出） =====
# json = 结构化 JSON 行（pino），生产日志采集用；级别 AGENT_LOG_LEVEL 默认 info
# AGENT_LOG_FORMAT=json
# AGENT_LOG_LEVEL=info

# ===== 幂等层存储（工具幂等去重） =====
# memory（默认，进程内 TTL）| redis（SET NX PX——多实例/重启语义正确，需 REDIS_URL）
# IDEMPOTENCY_STORE=redis

# ===== 真实持久化基座（week14 pgvector + week17 Redis，docker-compose.yml） =====
# 前置：pnpm infra:up（等 postgres / redis 两个服务 healthy）。
# 三个存储开关全部默认离线版（json / memory / memory）——不配置 = 与改造前行为完全一致；
# 想用哪个真实实现就把对应开关设过去，业务代码零改动（engine 的 env 工厂负责装配）。
#
# RAG_STORE：知识库存储 memory | json | pgvector（默认 json = .data/kb-store.json 快照）
# RAG_STORE=json
# RAG_STORE=pgvector
#
# SESSION_STORE：会话窗口存储 memory | redis（默认 memory）
# SESSION_STORE=redis
#
# PREFERENCE_STORE：用户偏好存储 memory | pg（默认 memory）
# PREFERENCE_STORE=pg
#
# EPISODIC_STORE：情景记忆存储 memory | pgvector（默认 memory；pgvector 与 RAG 共用
# PG 实例与 EMBEDDING_DIM 口径，`<=>` 余弦 top-k 召回历史会话摘要，跨重启）
# EPISODIC_STORE=pgvector
#
# PG 连接串：默认对准本仓 compose 的映射（宿主机 5433 → 容器 5432；
# 本机 5432 被已有容器 my-postgres 占用，故映射 5433，详见 docker-compose.yml 注释）
# PG_CONNECTION_STRING=postgres://agent:agent@localhost:5433/agent
#
# Redis 连接串（默认对准本仓 compose 的 6379 直通）
# REDIS_URL=redis://localhost:6379
#
# 向量维度：建表时固定（默认 2048 = GLM embedding-3）。换 embedding 模型（维度变化）
# 必须 DROP TABLE kb_chunks 后全库重嵌——不同维度没法比夹角。
# EMBEDDING_DIM=2048

# ===== web 前端（apps/web，可选）=====
# web 的环境变量在 apps/web/.env.example（NEXT_PUBLIC_API_BASE 等），复制为 apps/web/.env 使用。
# NEXT_PUBLIC_ 前缀是构建期内联——改 BFF 地址后要重启 dev / 重新 build 才生效。

# ===== 安全护栏（AGENT_GUARD_*，默认全关；零变化默认铁律） =====
# 六个开关写进本文件同样生效——启动期回填（engine config.ts hydrateGuardEnv），
# 真实环境变量优先于 .env（与 OPENAI_API_KEY 等其他键同一条 dotenv 契约）。
# AGENT_GUARD_PII=1                  # 工具输出 PII 脱敏（手机号/身份证/银行卡打码后再回给模型）
# AGENT_GUARD_ALLOWLIST=tool1,tool2  # MCP 工具白名单，不在名单内的调用被结构化拒绝
# AGENT_GUARD_CONFIRM=tool3          # 名单内工具执行前终端 y/n 确认（默认拒绝）
# AGENT_GUARD_INPUT=1                # 用户消息注入扫描拒收（灰度开关）
# AGENT_GUARD_MCP_STRICT=1           # MCP 重名合并严格模式（重名时本地胜出）
# AGENT_GUARD_LLM_SCAN=1             # HTTP API 侧：模型输出注入自检

# ===== Skills 技能目录（agent 的「知识扩展」，与 MCP 的「能力扩展」互补） =====
# 目录布局：<技能名>/SKILL.md（Anthropic agentskills.io 规范格式，frontmatter + 正文）。
# 配置后 chat 启动加载并全量注入 system prompt；默认 .agent-skills（仓库自带 refund-flow 示例）；
# 加载安全：路径遍历防护 / 单技能 16KB / 总量 64KB / 捆绑脚本永不执行 / 重名先到先得（见 engine/skills/）。
# SKILLS_DIR=D:\path\to\my-skills
