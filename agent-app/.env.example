# ===== LLM 网关配置（OpenAI 兼容协议，默认智谱 GLM，也可三选一） =====
#
# OPENAI_BASE_URL 可选值：
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4   ← 默认
#   DeepSeek       https://api.deepseek.com/v1
#   通义千问 Qwen   https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 对应 OPENAI_MODEL 参考值：
#   GLM:       glm-4-flash / glm-4-air / glm-4-plus
#   DeepSeek:  deepseek-chat
#   Qwen:      qwen-plus / qwen-turbo / qwen-max

OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash

# ===== Embedding 模型 =====
# 注意：查询与入库必须用同一个模型，混用则坐标空间不同，检索直接失真。
# 默认 GLM 网关自带 embeddings 接口；换网关时 EMBEDDING_MODEL 要跟着换：
#   GLM  示例: embedding-3（默认）/ embedding-2
#   Qwen 示例: text-embedding-v3（OPENAI_BASE_URL 用上面的 dashscope compatible-mode）
#   OpenAI : text-embedding-3-small（原生 1536 维）
#   注意：DeepSeek 网关不提供 embeddings 接口，切到 DeepSeek 后 RAG 不可用
EMBEDDING_MODEL=embedding-3

# ===== HTTP API（NestJS BFF，pnpm api 启动） =====
# 监听端口；不配置时默认 3000。环境变量 PORT 优先于 .env 文件里的值。
# PORT=3000

# ===== 工具审批（week18 Day 6，human-in-the-loop） =====
# 高危工具名单：流式对话里命中名单的工具执行前，BFF 先发 approval SSE 事件，
# 等用户在 web 界面点「允许 / 拒绝」（POST /api/chat/approve）再放行；拒绝时工具
# 收到结构化拒绝值 { denied: true, reason }，模型看得见、能礼貌收尾。
# 逗号分隔；未配置时默认 createTicket；显式置空（AGENT_CONFIRM_TOOLS=）= 关闭审批。
# AGENT_CONFIRM_TOOLS=createTicket
#
# 审批等待上限（毫秒）：超时未裁决自动拒绝并清理审批条目（默认 60000 = 60s）。
# AGENT_CONFIRM_TIMEOUT_MS=60000

# ===== 真实持久化基座（week14 pgvector + week17 Redis，docker-compose.yml） =====
# 前置：pnpm infra:up（等 postgres / redis 两个服务 healthy）。
# 三个存储开关全部默认离线版（json / memory / memory）——不配置 = 与改造前行为完全一致；
# 想用哪个真实实现就把对应开关设过去，业务代码零改动（engine 的 env 工厂负责装配）。
#
# RAG_STORE：知识库存储 memory | json | pgvector（默认 json = .data/kb-store.json 快照）
# RAG_STORE=json
# RAG_STORE=pgvector
#
# SESSION_STORE：会话窗口存储 memory | redis（默认 memory）
# SESSION_STORE=redis
#
# PREFERENCE_STORE：用户偏好存储 memory | pg（默认 memory）
# PREFERENCE_STORE=pg
#
# PG 连接串：默认对准本仓 compose 的映射（宿主机 5433 → 容器 5432；
# 本机 5432 被已有容器 my-postgres 占用，故映射 5433，详见 docker-compose.yml 注释）
# PG_CONNECTION_STRING=postgres://agent:agent@localhost:5433/agent
#
# Redis 连接串（默认对准本仓 compose 的 6379 直通）
# REDIS_URL=redis://localhost:6379
#
# 向量维度：建表时固定（默认 2048 = GLM embedding-3）。换 embedding 模型（维度变化）
# 必须 DROP TABLE kb_chunks 后全库重嵌——不同维度没法比夹角。
# EMBEDDING_DIM=2048
