# Dockerfile.api —— NestJS BFF（apps/api）的多阶段构建镜像
# 构建上下文 = agent-app 根（compose 的 build.context: .）；只产出运行所需，
# 构建期的 turbo/tsc/esbuild 重工具全部裁掉。运行命令与本地一致：node apps/api/dist/main.js。

# ── 阶段 1：base —— Node 22 + corepack/pnpm ──
# corepack 随 Node 自带，enable 后 pnpm 命令自动落到根 package.json 的
# packageManager 字段钉死的 11.17.0（与本地/CI 同版本，同款纪律见博客 deploy.yml）。
FROM node:22-slim AS base
RUN corepack enable
# 关掉 corepack 首次下载 pnpm 时的确认提示（非交互环境不需要）
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app

# ── 阶段 2：deps —— 依赖安装层（pnpm fetch 的 store 缓存）──
# 只先 COPY 锁文件与各包 package.json：源码改动不打穿这层缓存，lockfile 变了才重装。
# pnpm fetch 只认 lockfile → 独立缓存层；--offline 让 install 只吃 store，不碰网络。
# 顺序讲究：package.json（packageManager 钉 pnpm 11.17.0）与 pnpm-workspace.yaml
# 必须先于 pnpm 命令进来——否则 corepack 会用它自带的最新 pnpm（12.x），
# 与 pnpm 11 写的 lockfile 对不上账，直接 ERR_PNPM_LOCKFILE_CONFIG_MISMATCH。
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm fetch
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/cli/package.json apps/cli/
COPY packages/engine/package.json packages/engine/
COPY packages/shared/package.json packages/shared/
# frozen-lockfile：与 CI 同纪律，锁文件与 package.json 不一致直接报错
RUN pnpm install --frozen-lockfile --offline

# ── 阶段 3：build —— turbo 按依赖拓扑构建（shared → engine → api）──
FROM base AS build
COPY --from=deps /app ./
# .dockerignore 已挡掉 node_modules/dist/.next 等，这里进来的就是干净源码
COPY . .
ENV TURBO_TELEMETRY_DISABLED=1
# 过滤器 `@agent-app/api...` = api 自身 + 其 workspace 依赖（cli/web 不建，省时）
RUN pnpm turbo run build --filter=@agent-app/api...

# ── 阶段 4：runtime —— 只留 node 与构建产物 ──
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# 生产务实的取舍：整棵 node_modules 拷过来（pnpm 的包链接全是相对路径符号链接，
# 整树拷贝不断链），不为裁 devDeps 再引入 pnpm deploy 的复杂度——学习项目体积不是第一目标。
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/packages ./packages
EXPOSE 3000
# 环境变量（PG/Redis 连接串、存储开关、模型 key）一律由 compose 在运行期注入；
# 镜像本身零密钥（.dockerignore 已把 .env 挡在上下文外）。
CMD ["node", "apps/api/dist/main.js"]
