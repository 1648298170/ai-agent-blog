{
  "name": "@agent-app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API 端：NestJS BFF 服务壳（tsc 编译 emitDecoratorMetadata 后 node dist 运行）",
  "scripts": {
